###### Patch selected TEI components

##$PATCH_IDS## File with component ids to reprocess, one per line (e.g. PressMint-CZ_1848-04-06-392f65d0), needed only by patch-prepare
PATCH_IDS ?=
# one timestamp per make invocation (exported to sub-makes, so they share it)
ifndef PATCH_DATETIME
PATCH_DATETIME := $(shell date +%Y%m%d-%H%M%S)
endif
##$PATCH_DATA## Data directory of the patch (default: $(DATA) with suffix .patch.<DATETIME>), pass an existing one to continue
PATCH_DATA ?= $(patsubst %/,%,$(DATA)).patch.$(PATCH_DATETIME)
##$ERROR_DATA## Directory for the original (erroneous) outputs of patched components (default: $(DATA) with suffix .error.<DATETIME>)
ERROR_DATA ?= $(patsubst %/,%,$(DATA)).error.$(PATCH_DATETIME)

PATCH_TASKS = $(patsubst %/,%,$(PATCH_DATA))/patch-components.tasks

##patch-prepare## copy all files needed for patching components listed in $(PATCH_IDS), skipped when $(PATCH_DATA) is already prepared
#### 1. original outputs are copied from $(DATA) to $(ERROR_DATA): work/tei-text, work/tei-facs, work/tei-text.TT, work/tei-text.ana, dist/tei, dist/tei-ana
#### 2. inputs are copied from $(DATA) to $(PATCH_DATA): work/idMapping, work/ocrXML, work/imageRegions, work/tei-header
#### both directories keep the same structure as $(DATA)
#### make patch-prepare PATCH_IDS=ids.txt
patch-prepare: $(PATCH_TASKS)

$(PATCH_TASKS):
	@test -n "$(PATCH_IDS)" && test -f "$(PATCH_IDS)" || { echo "ERROR: $(PATCH_DATA) is not prepared and PATCH_IDS file is not defined or does not exist" >&2; exit 1; }
	@PATCH=$(patsubst %/,%,$(PATCH_DATA)); \
	ERR=$(patsubst %/,%,$(ERROR_DATA)); \
	SRC=$(patsubst %/,%,$(DATA)); \
	mkdir -p "$$PATCH" "$$ERR"; \
	sed 's/\.\(xml\|jsonl\)$$//;s@^.*/@@;/^[[:space:]]*$$/d' "$(PATCH_IDS)" | sort -u \
	  | sed -E 's@^(PressMint-CZ_([0-9]{4})-.*)$$@\2/\1@' > "$@.tmp"; \
	copy_files() { \
	  DSTDIR=$$1; shift; \
	  for f in "$$@"; do \
	    if [ ! -e "$$SRC/$$f" ]; then \
	      echo "WARN: missing $$SRC/$$f" >&2; \
	    elif [ ! -e "$$DSTDIR/$$f" ]; then \
	      (cd "$$SRC" && cp -r --parents "$$f" "$$DSTDIR/"); \
	    fi; \
	  done; \
	}; \
	while read -r COMP; do \
	  copy_files "$$ERR" \
	    work/tei-text/$$COMP.xml work/tei-facs/$$COMP.xml work/tei-text.TT/$$COMP.xml work/tei-text.ana/$$COMP.xml \
	    dist/tei/$$COMP.xml dist/tei-ana/$$COMP.ana.xml; \
	  copy_files "$$PATCH" \
	    work/idMapping/$$COMP.jsonl work/ocrXML/$$COMP work/imageRegions/$$COMP.jsonl work/tei-header/$$COMP.xml; \
	done < "$@.tmp"; \
	cp "$@.tmp" "$$ERR/patch-components.tasks"; \
	printf 'SOURCE_DATA=%s\nERROR_DATA=%s\n' "$$SRC" "$$ERR" > "$$PATCH/patch.info"; \
	mv "$@.tmp" "$@"; \
	echo "INFO: $$(wc -l < "$@") components: original outputs copied to $$ERR, inputs copied to $$PATCH"

##patch-components## reprocess components listed in $(PATCH_DATA)/patch-components.tasks, ends just before process-build
#### outputs are recreated in $(PATCH_DATA): work/tei-text, work/tei-facs, work/tei-text.TT, work/tei-text.ana
#### finished components are listed in patch-components.done and skipped when continuing, failed ones in patch-components.failed
#### start:    make patch-components PATCH_IDS=ids.txt
#### continue: make patch-components PATCH_DATA=Data.patch.<DATETIME>
patch-components: patch-prepare
	@PATCH=$(patsubst %/,%,$(PATCH_DATA)); \
	touch "$$PATCH/patch-components.done"; \
	rm -f "$$PATCH/patch-components.failed"; \
	while read -r COMP; do \
	  if grep -qxF "$$COMP" "$$PATCH/patch-components.done"; then \
	    echo "INFO: skipping $$COMP, already patched"; \
	    continue; \
	  fi; \
	  if make patch-component DATA="$$PATCH/" COMPONENT_PATH="$$COMP" </dev/null; then \
	    echo "$$COMP" >> "$$PATCH/patch-components.done"; \
	  else \
	    echo "$$COMP" >> "$$PATCH/patch-components.failed"; \
	    echo "ERROR: patching $$COMP failed" >&2; \
	  fi; \
	done < "$(PATCH_TASKS)"; \
	echo "INFO: $$(wc -l < "$$PATCH/patch-components.done") of $$(wc -l < "$(PATCH_TASKS)") components patched in $$PATCH"; \
	test ! -s "$$PATCH/patch-components.failed" || echo "WARN: $$(wc -l < "$$PATCH/patch-components.failed") components failed, see $$PATCH/patch-components.failed" >&2; \
	echo "INFO: continue with: make patch-components PATCH_DATA=$$PATCH"

##slurm-patch-components## submit patch-components as one slurm job (sbatch --wrap, no external parallelization), log in logs/slurm/patch_<JOBID>.out
#### start:    make slurm-patch-components PATCH_IDS=ids.txt
#### continue: make slurm-patch-components PATCH_DATA=Data.patch.<DATETIME>
slurm-patch-components:
	@test -f "$(PATCH_TASKS)" || { test -n "$(PATCH_IDS)" && test -f "$(PATCH_IDS)"; } || { echo "ERROR: $(PATCH_DATA) is not prepared and PATCH_IDS file is not defined or does not exist" >&2; exit 1; }
	@mkdir -p logs/slurm
	sbatch --job-name=PressMint-patch \
	       --partition=cpu-troja,cpu-ms \
	       --gres=none \
	       --cpus-per-task=8 \
	       --mem=16G \
	       --output=logs/slurm/patch_%j.out \
	       --wrap="make patch-components DATA=$(abspath $(DATA))/ SAMPLE=$(SAMPLE) PATCH_DATA=$(abspath $(PATCH_DATA)) ERROR_DATA=$(abspath $(ERROR_DATA))$(if $(PATCH_IDS), PATCH_IDS=$(abspath $(PATCH_IDS)))"
	@echo "INFO: patch data: $(abspath $(PATCH_DATA))"
	@echo "INFO: continue with: make slurm-patch-components PATCH_DATA=$(abspath $(PATCH_DATA))"

patch-component:
	@test -f "$(idMapping)/$(COMPONENT_PATH).jsonl" || { echo "ERROR: no id mapping for $(COMPONENT_PATH)" >&2; exit 1; }
	@test -d "$(xmlOCR)/$(COMPONENT_PATH)" || { echo "ERROR: no OCR output for $(COMPONENT_PATH)" >&2; exit 1; }
	@test -f "$(imageRegions)/$(COMPONENT_PATH).jsonl" || { echo "ERROR: no image regions for $(COMPONENT_PATH)" >&2; exit 1; }
	@echo "INFO: patching $(COMPONENT_PATH) in $(DATA)"
	rm -f $(TEItext)/$(COMPONENT_PATH).xml \
	      $(TEIfacs)/$(COMPONENT_PATH).xml \
	      $(TEItextTT)/$(COMPONENT_PATH).xml \
	      $(TEItextANA)/$(COMPONENT_PATH).xml
	make process-data-byPath COMPONENT_PATH=$(COMPONENT_PATH)
	test -f $(TEItext)/$(COMPONENT_PATH).xml
	mkdir -p $(dir $(TEItextTT)/$(COMPONENT_PATH)) $(dir $(TEItextANA)/$(COMPONENT_PATH))
	cp $(TEItext)/$(COMPONENT_PATH).xml $(TEItextTT)/$(COMPONENT_PATH).xml
	make teiText2tt-single FILE=$(TEItextTT)/$(COMPONENT_PATH).xml
	make TT2teiANA-single FILE=$(TEItextTT)/$(COMPONENT_PATH).xml OUTPUT=$(TEItextANA)/$(COMPONENT_PATH).xml
	test -f $(TEItextANA)/$(COMPONENT_PATH).xml

##patch-apply## copy patched outputs from $(PATCH_DATA) back to $(DATA) (components listed in $(PATCH_DATA)/patch-components.tasks)
#### only complete components (all of tei-text, tei-facs, tei-text.TT, tei-text.ana) are applied, then run: make process-build
#### make patch-apply PATCH_DATA=Data.patch.<DATETIME>
patch-apply:
	@test -n "$(PATCH_DATA)" && test -f "$(PATCH_DATA)/patch-components.tasks" || { echo "ERROR: PATCH_DATA is not defined or has no patch-components.tasks" >&2; exit 1; }
	@PATCH=$(patsubst %/,%,$(PATCH_DATA)); \
	DST=$(patsubst %/,%,$(DATA)); \
	test "$$(realpath "$$PATCH")" != "$$(realpath "$$DST")" || { echo "ERROR: PATCH_DATA and DATA are the same directory" >&2; exit 1; }; \
	APPLIED=0; \
	while read -r COMP; do \
	  FILES="work/tei-text/$$COMP.xml work/tei-facs/$$COMP.xml work/tei-text.TT/$$COMP.xml work/tei-text.ana/$$COMP.xml"; \
	  MISSING=""; \
	  for f in $$FILES; do test -f "$$PATCH/$$f" || MISSING="$$MISSING $$f"; done; \
	  if [ -n "$$MISSING" ]; then \
	    echo "WARN: skipping $$COMP, missing in $$PATCH:$$MISSING" >&2; \
	    continue; \
	  fi; \
	  (cd "$$PATCH" && cp --parents $$FILES "$$DST/"); \
	  APPLIED=$$((APPLIED+1)); \
	done < "$$PATCH/patch-components.tasks"; \
	echo "INFO: $$APPLIED of $$(wc -l < "$$PATCH/patch-components.tasks") components applied to $$DST"; \
	echo "INFO: continue with: make DATA=$$DST/ process-build"
